# Copy to .env and fill in. .env is gitignored — never commit the token.
# See README §5 "SonarQube analysis".

# SonarQube server URL (your sonnar-cube stack publishes it here).
SONAR_HOST_URL=http://localhost:9000

# Analysis token (SonarQube → My Account → Security → Generate Token).
# Needs Execute Analysis permission on the project.
SONAR_TOKEN=paste-your-token-here

# Project key (must already exist on the server).
SONAR_PROJECT_KEY=core-brain

# run-sonar-cover.sh only: LCOV report path(s), comma-separated.
SONAR_LCOV_PATHS=coverage/lcov.info
