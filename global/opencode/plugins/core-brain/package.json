  "license": "MIT",
  "keywords": ["opencode", "opencode-plugin", "memory", "vectors", "isolation", "recall"],
  "repository": {
    "type": "git",
    "url": "https://github.com/open-eletric-sheep-count/core-brain.git",
    "directory": "global/opencode/plugins/core-brain"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./index.ts",
  "exports": {
    ".": "./index.ts"
  },
  "files": [
    "index.ts",
    "store.ts",
    "types.ts",
    "config.json",
    "LICENSE",
    "README.md",
    "INSTALACAO.md",
    "mcp"
  ],
  "scripts": {
    "prepublishOnly": "node --input-type=module -e \"await import('./index.ts')\""
  }
}
